{
  "disable_error_code": [
    "annotation-unchecked"
  ],
  "enable_error_code": [
    "explicit-override",
    "ignore-without-code",
    "possibly-undefined"
  ],
  "exclude": [
    "docs/docusaurus",
    "docs/expectation_gallery",
    "docs/readme_assets",
    "docs/sphinx_api_docs_source",
    "great_expectations/_version\\.py"
  ],
  "files": [
    "docs",
    "great_expectations",
    "tests"
  ],
  "follow_imports": "normal",
  "overrides": [
    {
      "module": "IPython.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "boto3.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "botocore.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "clickhouse_sqlalchemy.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "contrib.experimental.great_expectations_experimental.*",
      "setting": "ignore_errors",
      "value": "true"
    },
    {
      "module": "databricks.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "flaky.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "google.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "great_expectations.compatibility.azure",
      "setting": "disable_error_code",
      "value": "[\"assignment\"]"
    },
    {
      "module": "great_expectations.compatibility.pydantic.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "pyarrow.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "pyodbc",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "pypd.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "pytest_timeout.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "ruamel.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "scipy.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "sempy.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "snowflake.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "sqlalchemy_bigquery.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "sqlalchemy_dremio.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "sqlalchemy_redshift.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "teradatasqlalchemy.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    },
    {
      "module": "trino.*",
      "setting": "ignore_missing_imports",
      "value": "true"
    }
  ]
}
